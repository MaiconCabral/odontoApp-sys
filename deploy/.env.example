# Values of the demo server. Copy to /opt/odonto/.env on the VPS and fill in the blanks.
# Replace odonto.example.com with the real central domain everywhere.

# --- Stack ---
IMAGE_TAG=latest
NPM_NETWORK=nginx-proxy-manager_default
MYSQL_ROOT_PASSWORD=

# --- Laravel ---
APP_NAME=odontoApp
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=https://odonto.example.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

# Demo server: seeds the demo clinics and wipes everything every day at 04:00 (demo:reset).
DEMO_MODE=true
SEED_DEMO_PASSWORD=
# Global panel at https://odonto.example.com/admin (12+ characters, letters and numbers).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME="Equipe odontoApp"

# Behind Nginx Proxy Manager and the router.
TRUSTED_PROXIES=*

# Clinics live at <slug>.odonto.example.com.
TENANCY_CENTRAL_DOMAINS=odonto.example.com
FRONTEND_URL=https://odonto.example.com
FRONTEND_URL_TEMPLATE=https://{host}
SANCTUM_STATEFUL_DOMAINS=odonto.example.com,*.odonto.example.com
# No CORS setting: the router serves the API on the same host as the pages (same origin).

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# The database name must start with odonto_ (the MySQL user only has odonto_% databases).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=odonto_app
DB_USERNAME=odonto
DB_PASSWORD=
DB_QUEUE_CONNECTION=mysql
TENANCY_DB_PREFIX=odonto_tenant_

QUEUE_CONNECTION=database
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
LOG_CHANNEL=stderr
LOG_LEVEL=info

# The demo never sends real e-mails; they go to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=nao-responda@odonto.example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Nuxt ---
NUXT_PUBLIC_API_BASE=https://{host}
NUXT_PUBLIC_CENTRAL_DOMAIN=odonto.example.com
NUXT_PUBLIC_SALES_CONTACT_URL=
