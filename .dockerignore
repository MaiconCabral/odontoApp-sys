# Build context of deploy/*.Dockerfile is the repo root; only backend/ and frontend/ sources go in.
.git
.github
.cursor
.agents
.claude
deploy/.env
**/.env
**/.env.*
!**/.env.example

backend/vendor
backend/node_modules
backend/storage/app/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/bootstrap/cache/*.php
backend/database/*.sqlite
backend/tests
backend/.phpunit.cache

frontend/node_modules
frontend/.nuxt
frontend/.output
frontend/.data
frontend/coverage
frontend/tests
